# ─────────────────────────────────────────────────────────────────────────────
# Sarvistar – Environment variable template
# Copy this file to .env.local and fill in real values.
# NEVER put real secrets in this file — it IS committed to version control.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED – Full URL of the n8n webhook that handles content transformation.
# Example: https://your-n8n-instance.example.com/webhook/abc123
N8N_WEBHOOK_URL=

# OPTIONAL – Shared secret sent as the "X-Webhook-Secret" request header.
# Set the same value in your n8n workflow's webhook credential/header validation
# to prevent unauthenticated calls. Leave blank to skip the header entirely.
N8N_WEBHOOK_SECRET=

# OPTIONAL – Anthropic Claude API key used by the /api/generate streaming route.
# When absent, the route falls back to the built-in high-fidelity simulated
# stream so the app remains fully functional offline or in demo mode.
ANTHROPIC_API_KEY=
