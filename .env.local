# ─────────────────────────────────────────────────────────────────────────────
# Sarvistar – Local environment variables
# DO NOT commit this file. It is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# n8n webhook endpoint that receives the transform request JSON and runs the
# multi-agent AI workflow. Replace with your actual n8n production or test URL.
N8N_WEBHOOK_URL=https://sarvistar.app.n8n.cloud/webhook/789c2a39-ea9d-421c-8557-135daab44817
#N8N_WEBHOOK_URL=https://webhook.site/898a7707-f649-4a4c-a4ac-10199203f761

# Optional shared secret sent as the X-Webhook-Secret header so n8n can verify
# the request came from this server. Leave blank to disable header injection.
N8N_WEBHOOK_SECRET=

# Anthropic API key – used by the /api/generate streaming route (simulated
# fallback is used automatically when this key is absent).
ANTHROPIC_API_KEY=

# ── Demo Mode Switch ──────────────────────────────────────────────────────────
# Set to 'true' for deterministic demo fixtures.
# Set to 'false' to restore live n8n pipeline.
NEXT_PUBLIC_DEMO_MODE=true
